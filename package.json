{
  "name": "mobile-2048-game",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/StarryCode-Lang/2048.git"
  },
  "bugs": "https://github.com/StarryCode-Lang/2048/issues",
  "homepage": "https://ai2048.roberfan.chatgpt.site",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite",
    "build": "vinext build",
    "start": "vinext start",
    "build:verified": "node scripts/build-verified.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run test:fairness && npm run test:ai && npm run test:replay && npm run test:i18n",
    "test:fairness": "node --experimental-strip-types --test tests/game-random.test.mjs tests/game-rules.test.mjs",
    "test:ai": "node --experimental-strip-types --test tests/ai-*.test.mjs",
    "test:i18n": "node --experimental-strip-types --test tests/i18n.test.mjs",
    "benchmark:ai": "node --experimental-strip-types scripts/benchmark-ai.ts",
    "benchmark:ai:suite": "node --experimental-strip-types scripts/benchmark-ai-suite.ts",
    "test:replay": "node --experimental-strip-types --test tests/replay-log.test.mjs",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "audit:all": "npm audit --registry=https://registry.npmjs.org",
    "audit:prod": "npm audit --omit=dev --registry=https://registry.npmjs.org",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build:verified && npm run test:rendered && npm run audit:all",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  },
  "type": "module",
  "displayName": "2048 · 数字合成",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260820.1": true
  }
}
